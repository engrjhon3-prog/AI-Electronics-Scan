rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isPremiumUser() {
      return signedIn() && (
        request.auth.token.premium == true
        || (request.auth.token.email != null
            && exists(/databases/$(database)/documents/entitlements/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/entitlements/$(request.auth.token.email.lower())).data.premium == true)
      );
    }

    // Per-user profile + synced data. Owners only (admins can read for support).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;

      // Uploaded scan photos with retention:
      //   free -> expires <= 12h from now, Pro -> expires <= 7 days from now.
      // Expired documents become unreadable immediately; a scheduled job
      // physically deletes them.
      match /uploads/{uploadId} {
        allow read: if signedIn()
          && (request.auth.uid == uid || isAdmin())
          && resource.data.expiresAt > request.time;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time
              + (isPremiumUser() ? duration.value(7, 'd') : duration.value(12, 'h'))
          && request.resource.data.imageB64 is string
          && request.resource.data.imageB64.size() < 950000;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow update: if false;
      }
    }

    // Pro entitlements, keyed by lowercased email. Written automatically by
    // the payment backend when a GCash payment clears (the Admin SDK bypasses
    // these rules) and, for comped accounts, by an admin. A signed-in user may
    // read their own entitlement — that read is what unlocks Pro in the app.
    match /entitlements/{email} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email != null
            && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Payment ledger, keyed by checkout reference. Written server-side only —
    // no client may forge a "paid" record. Admins can read it for support.
    match /payments/{reference} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
